@baseUrl = http://localhost/api/platform
@userId = cf0138b7-3272-4d1c-a34d-de88a47fe94c

### GET all games
GET {{baseUrl}}/games
Accept: application/json

### POST games by filter - Board games only
POST {{baseUrl}}/games/filter
Content-Type: application/json

{
  "categories": [
    "BOARDGAME",
    "NATIVE"
  ]
}

### POST games by filter - Price range (under 2.00)
POST {{baseUrl}}/games/filter
Content-Type: application/json

{
  "minPrice": {
    "currency": "EUR",
    "amount": 0
  },
  "maxPrice": {
    "currency": "EUR",
    "amount": 2.00
  }
}

### POST games by filter - Combined filters (boardgame under 5.00)
POST {{baseUrl}}/games/filter
Content-Type: application/json

{
  "categories": [
    "BOARDGAME"
  ],
  "maxPrice": {
    "currency": "EUR",
    "amount": 5.00
  }
}

### POST games by filter - No results expected
POST {{baseUrl}}/games/filter
Content-Type: application/json

{
  "categories": [
    "STRATEGY"
  ]
}

### GET user with owned games
GET {{baseUrl}}/users/{{userId}}/games
Content-Type: application/json
Accept: application/json

